{
  "name": "@chatlol/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 src/api.test.js src/ai.test.js src/cluster.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@chatlol/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "socket.io-client": "^4.8.4"
  },
  "main": "src/index.js"
}
