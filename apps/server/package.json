{
  "name": "@chatlol/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "check": "node ../../scripts/check-syntax.mjs src",
    "seed": "node src/seed.js --reset",
    "db:migrate-ids": "node --env-file-if-exists=.env src/scripts/migrate-object-ids.js",
    "test": "node --test --test-concurrency=1 src/api.test.js src/ai.test.js src/shared.test.js src/push.test.js src/cluster.test.js src/features.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@chatlol/shared": "*",
    "@socket.io/mongo-adapter": "^0.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "mongodb": "^6.21.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^10.4.3",
    "socket.io-client": "^4.8.4"
  },
  "main": "src/index.js"
}
