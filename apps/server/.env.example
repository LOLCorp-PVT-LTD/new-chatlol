PORT=4000
# Comma separated list of allowed web origins (Vite dev server, Expo web, Electron)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,app://chatlol
# Long random string — tokens are HMAC-SHA256 signed with it
JWT_SECRET=change-me-to-a-long-random-string
# ——— MongoDB ———
# Local:  mongodb://127.0.0.1:27017/chatlol
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/chatlol?retryWrites=true&w=majority
# Leave empty in development: uses a local mongod on 27017 if one is running,
# otherwise starts an embedded MongoDB that stores its data in ./data/mongo.
MONGODB_URL=
# Optional: database name (defaults to the one in the URL, else "chatlol")
MONGODB_DB=
# Optional: Redis. Not needed — MongoDB handles shared state and realtime between API instances.
# Set it only if you want Redis to take that over on a very busy deployment.
# REDIS_URL=redis://localhost:6379
PUBLIC_URL=http://localhost:4000

# ——— NVIDIA NIM (https://build.nvidia.com) ———
# A free NVIDIA developer key gives access to the hosted NIM endpoints below.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Rotated per persona. All are free-tier hosted models on build.nvidia.com.
NIM_MODELS=meta/llama-3.3-70b-instruct,openai/gpt-oss-120b,openai/gpt-oss-20b,meta/llama-4-scout-17b-16e-instruct,nvidia/nemotron-3-nano-30b-a3b
# At startup (and every 6h) the API probes these plus ~25 built-in candidates and keeps up to this many that answer.
NIM_MAX_POOL=24
# Used first whenever they work (in order), including right after a restart
NIM_PREFERRED_MODELS=nvidia/nemotron-3-super-120b-a12b
# Content safety model used to screen user + AI text (leave blank to use the local filter only)
NIM_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
# Max AI requests per minute across all personas (free tier is rate limited)
NIM_RPM=30
# Set to 0 to disable the persona engine entirely
AI_PERSONAS_ENABLED=1
# Personas send generated photos in DMs when asked (FLUX via NIM_IMAGE_URL); max per conversation per day
AI_DM_PHOTOS=1
AI_DM_PHOTOS_PER_DAY=5
# How "busy" the personas are: 1 = default, 2 = twice as active
AI_ACTIVITY=1

# ——— Push notifications (each platform's own free service) ———
# iPhone — Apple Push Notification service. Apple Developer → Certificates, IDs & Profiles → Keys → "+" →
# enable "Apple Push Notifications service (APNs)" → download the .p8 (once!). Key ID is shown on the key page,
# Team ID in the top-right of the developer site.
APNS_TEAM_ID=
APNS_KEY_ID=
# The .p8 file's path, or its contents (write newlines as \n)
APNS_KEY=
APNS_BUNDLE_ID=app.chatlol
# production for App Store / TestFlight builds, sandbox for development builds
APNS_ENV=production
# Android — Firebase Cloud Messaging (free). Firebase console → Project settings → Service accounts →
# "Generate new private key". Path to the downloaded JSON, or the JSON itself on one line.
# The app also needs google-services.json in apps/native (Project settings → Your apps → Android app app.chatlol).
FIREBASE_SERVICE_ACCOUNT=
# Web browsers — standard Web Push (free). Leave blank and keys are generated once and stored in the database;
# or generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chatlol.app

# Image generation for AI persona photo posts (NIM visual GenAI endpoint). Blank = use stock placeholder photos.
NIM_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell
# Optional: image models to try in order (comma-separated). If one fails, FLUX.1-dev, SD3 Medium and SDXL are tried next.
# NIM_IMAGE_URLS=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell,https://ai.api.nvidia.com/v1/genai/stabilityai/stable-diffusion-3-medium
# Vision model so personas can actually "see" photos people post before commenting
NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ——— Admin panel ———
# Comma-separated emails that get the admin role (they're promoted on their next login). Open /admin in the web app.
ADMIN_EMAILS=you@yourdomain.com

# ——— Email (verification, password reset, email-change notices) ———
# Leave SMTP_HOST empty in development: emails are printed to this server's log instead.
# Your SMTP server. Port 587 = STARTTLS, 465 = TLS (set SMTP_SECURE=true), 25 = plain.
# Set SMTP_ALLOW_SELF_SIGNED=1 if your mail server uses a self-signed certificate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_ALLOW_SELF_SIGNED=0
MAIL_FROM=ChatLOL <no-reply@yourdomain.com>
# Web app address used in email links (verify / reset)
APP_URL=http://localhost:5173

# ——— Payments ———
# Stripe (web + desktop): Dashboard → Developers → API keys / Webhooks.
# Webhook URL: https://YOUR_API/api/payments/stripe/webhook  — events: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# RevenueCat (iOS + Android in-app purchases): Project → Integrations → Webhooks.
# Webhook URL: https://YOUR_API/api/payments/revenuecat/webhook  — set the Authorization header value to this secret.
REVENUECAT_WEBHOOK_AUTH=

# ——— Spotify (optional) ———
# Song search for profiles works without these (Apple Music, 30-second previews).
# With them, search uses Spotify and plays full songs (developer.spotify.com → Create app).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: YouTube Data API v3 key — plays profile songs in FULL for every visitor (Spotify only gives 30-second
# previews to people not signed in to Spotify). Members can also paste a YouTube link without it.
YOUTUBE_API_KEY=

# Bigger NIM model used for one-to-one DMs with personas
NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct
