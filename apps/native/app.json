{
  "expo": {
    "name": "ChatLOL",
    "slug": "chatlol",
    "version": "0.1.0",
    "scheme": "chatlol",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8f5"
    },
    "ios": {
      "bundleIdentifier": "app.chatlol",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:chatlol.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.chatlol",
      "adaptiveIcon": {
        "backgroundColor": "#fd6a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chatlol.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#fff8f5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1a110c"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ChatLOL needs your photos so you can post drops and vibes.",
          "cameraPermission": "ChatLOL uses the camera for Sunset Drops and going live."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock ChatLOL with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ff5e00",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "ChatLOL uses the camera when you go live and for Sunset Drops.",
          "microphonePermission": "ChatLOL uses the microphone when you go live."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": ""
      }
    }
  }
}
