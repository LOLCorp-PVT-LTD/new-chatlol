# Where the ChatLOL API runs. Use your LAN IP (e.g. http://192.168.1.20:4000) when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:4000
# RevenueCat public SDK keys (Project → API keys). Leave blank to hide in-app purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
