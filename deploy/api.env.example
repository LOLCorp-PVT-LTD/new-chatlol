# ChatLOL API settings for https://chatlol.net. Copy to /etc/chatlol/api.env (chmod 600, owned by root).
# PORT (4510), HOST (127.0.0.1) and NODE_ENV come from the PM2 config (deploy/pm2/ecosystem.config.cjs). Every other setting is described in apps/server/.env.example.

NODE_ENV=production
# 64+ random characters:  openssl rand -hex 48
JWT_SECRET=

# Where people reach the site. Email links, upload URLs and allowed browser origins all use it.
APP_URL=https://chatlol.net
PUBLIC_URL=https://chatlol.net
# app://chatlol is the desktop app.
CORS_ORIGINS=https://chatlol.net,app://chatlol

# MongoDB: a replica set (MongoDB Atlas, or your own with --replSet).
MONGODB_URL=mongodb://127.0.0.1:27017/chatlol?replicaSet=rs0

# Uploaded photos on this server's disk. nginx serves this folder at /uploads/.
# Ignored once S3_BUCKET is set (photos go to Cloudflare R2 instead, see below).
UPLOAD_DIR=/var/lib/chatlol/uploads

# Cloudflare R2 for uploads (recommended). Steps: deploy/README.md, "Uploads on Cloudflare R2".
# Leave S3_BUCKET empty to keep uploads on disk.
S3_BUCKET=
S3_REGION=auto
# https://<your account id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# The bucket's public address: its custom domain
S3_PUBLIC_URL=https://media.chatlol.net
# R2 API token with Object Read & Write on this bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# These emails become admins when they next sign in.
ADMIN_EMAILS=

# Email (verification + password reset). Without it, emails are only printed to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ChatLOL <hello@chatlol.net>

# AI personas (NVIDIA NIM)
NVIDIA_API_KEY=

# Live video relay (your coturn). TURN_SECRET must equal coturn's static-auth-secret.
TURN_URLS=turn:turn.chatlol.net:3478?transport=udp,turn:turn.chatlol.net:3478?transport=tcp,turns:turn.chatlol.net:5349?transport=tcp
TURN_SECRET=

# Payments: the Stripe webhook URL is https://chatlol.net/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# RevenueCat webhook URL: https://chatlol.net/api/payments/revenuecat/webhook
REVENUECAT_WEBHOOK_AUTH=
