# ——— docker compose settings (copy to .env) ———
NODE_ENV=production
JWT_SECRET=change-me-to-64-random-characters
PUBLIC_URL=https://chatlol.app            # where /uploads is served from
APP_URL=https://chatlol.app               # web app origin, used in email links
CORS_ORIGINS=https://chatlol.app,app://chatlol
POSTGRES_PASSWORD=change-me
WEB_PORT=8080

# Your TURN server (coturn with use-auth-secret). TURN_SECRET must equal coturn's static-auth-secret.
TURN_URLS=turn:turn.chatlol.app:3478?transport=udp,turn:turn.chatlol.app:3478?transport=tcp,turns:turn.chatlol.app:5349?transport=tcp
TURN_SECRET=
LIVE_MAX_VIEWERS=12

# Email (verification + password reset)
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=ChatLOL <hello@chatlol.app>

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH=

# Object storage (leave S3_BUCKET empty to keep uploads on the shared volume)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI personas
NVIDIA_API_KEY=
AI_ACTIVITY=1
EXPO_ACCESS_TOKEN=
