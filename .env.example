# ——— docker compose settings (copy to .env) ———
NODE_ENV=production
JWT_SECRET=change-me-to-64-random-characters
PUBLIC_URL=https://chatlol.app            # where /uploads is served from
APP_URL=https://chatlol.app               # web app origin, used in email links
CORS_ORIGINS=https://chatlol.app,app://chatlol
# Leave empty to use the bundled MongoDB container, or point at MongoDB Atlas:
# MONGODB_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/chatlol?retryWrites=true&w=majority
MONGODB_URL=
WEB_PORT=8080

# Your TURN server (coturn with use-auth-secret). TURN_SECRET must equal coturn's static-auth-secret.
TURN_URLS=turn:turn.chatlol.app:3478?transport=udp,turn:turn.chatlol.app:3478?transport=tcp,turns:turn.chatlol.app:5349?transport=tcp
TURN_SECRET=
LIVE_MAX_VIEWERS=12

# Admin panel (/admin): these emails become admins on their next login
ADMIN_EMAILS=

# Email (verification + password reset)
# Your SMTP server. Port 587 = STARTTLS, 465 = TLS (set SMTP_SECURE=true), 25 = plain.
# Set SMTP_ALLOW_SELF_SIGNED=1 if your mail server uses a self-signed certificate.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
SMTP_ALLOW_SELF_SIGNED=0
MAIL_FROM=ChatLOL <no-reply@yourdomain.com>

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH=

# Object storage (leave S3_BUCKET empty to keep uploads on the shared volume)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Spotify song search on profiles (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI personas
NVIDIA_API_KEY=
AI_ACTIVITY=1
# Push: see apps/server/.env.example (APNs for iPhone, Firebase for Android, Web Push for browsers)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY=
APNS_BUNDLE_ID=app.chatlol
APNS_ENV=production
FIREBASE_SERVICE_ACCOUNT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chatlol.app
