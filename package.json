{
  "name": "chatlol",
  "private": true,
  "version": "0.1.0",
  "description": "ChatLOL \u2014 the golden-hour social network. Vue web, React Native (iOS/Android/desktop), Node realtime API with NVIDIA NIM AI personas.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "npm run dev -w @chatlol/server",
    "dev:web": "npm run dev -w @chatlol/web",
    "dev:native": "npm run start -w @chatlol/native",
    "dev:desktop": "npm run dev -w @chatlol/desktop",
    "build:web": "npm run build -w @chatlol/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
